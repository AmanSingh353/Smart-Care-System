# Smart Care System — Backend environment template
# Copy to .env for local development. Never commit real values.

PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Frontend origin for CORS + Socket.io (exact URL, no trailing slash)
CLIENT_URL=http://localhost:5173

# MongoDB (optional — empty uses in-memory staff store for hackathon)
MONGODB_URI=

# ---------------------------------------------------------------------------
# Firebase Admin (backend-only — verifies ID tokens, creates staff identities)
# Never expose these to the frontend or VITE_* variables.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Escaped newlines: -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# First admin bootstrap (used ONLY when no admin user exists)
# Password is optional: if set with Admin SDK, creates Firebase Auth user.
# Never hardcode this password in the frontend or commit it.
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@smartcare.demo
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=System Administrator

# Optional CareGuard thresholds (minutes)
# CAREGUARD_LAB_DELAY_MINUTES=15
# CAREGUARD_TREATMENT_GRACE_MINUTES=0
