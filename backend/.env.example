# Smart Care System — Backend environment template
# Copy to .env for local development. Never commit real values.

PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Frontend origin for CORS + Socket.io (exact URL, no trailing slash)
CLIENT_URL=http://localhost:5173

# MongoDB (recommended for production). When empty, StaffUser records persist to
# backend/data/staff-users.json (local durable file store — not in-memory).
MONGODB_URI=

# ---------------------------------------------------------------------------
# Firebase Admin (backend-only — verifies ID tokens, creates staff identities)
# Never expose these to the frontend or VITE_* variables.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Escaped newlines: -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# First admin bootstrap (used ONLY when no admin user exists)
# Password is optional: if set with Admin SDK, creates Firebase Auth user.
# Never hardcode this password in the frontend or commit it.
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@smartcare.demo
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=System Administrator

# ---------------------------------------------------------------------------
# Connected Hospitals — identity of THIS SCS deployment (idempotent on startup)
# Does not seed partner hospitals. Register partners via Admin → Network.
# ---------------------------------------------------------------------------
LOCAL_HOSPITAL_ID=HOSP-001
LOCAL_HOSPITAL_NAME=Smart Care Hospital
# LOCAL_HOSPITAL_REGISTRATION=
# LOCAL_HOSPITAL_ADDRESS=
# LOCAL_HOSPITAL_CITY=Delhi
# LOCAL_HOSPITAL_STATE=Delhi
# LOCAL_HOSPITAL_PHONE=
# LOCAL_HOSPITAL_EMAIL=
# LOCAL_HOSPITAL_DEPARTMENTS=Emergency,Cardiology,ICU
# LOCAL_HOSPITAL_FACILITIES=ICU,Ventilator,Blood Bank

# Optional CareGuard thresholds (minutes)
# CAREGUARD_LAB_DELAY_MINUTES=15
# CAREGUARD_TREATMENT_GRACE_MINUTES=0
