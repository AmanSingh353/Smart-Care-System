# Smart Care System — Backend environment template
# Copy to .env for local development. Never commit real .env values.
#
# Deploy target: Render (Node + Express + Socket.io)

# HTTP listen port (Render sets PORT automatically; local default 5000)
PORT=5000

# Bind address — use 0.0.0.0 on Render / Docker
HOST=0.0.0.0

NODE_ENV=development

# Frontend origin for CORS + Socket.io (exact URL, no trailing slash)
# Local:  http://localhost:5173
# Prod:   https://YOUR-FRONTEND-URL  (Vercel deployment URL)
CLIENT_URL=http://localhost:5173

# MongoDB connection string (leave empty to run without DB — demo / stub mode)
MONGODB_URI=

# ---------------------------------------------------------------------------
# Firebase Admin (backend-only — not implemented in app code yet)
# Set these when wiring Firebase Authentication verification on the API.
# Never expose private keys to the frontend or VITE_* variables.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Use escaped newlines in env hosts, e.g. -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
FIREBASE_PRIVATE_KEY=

# Optional CareGuard thresholds (minutes)
# CAREGUARD_LAB_DELAY_MINUTES=15
# CAREGUARD_TREATMENT_GRACE_MINUTES=0
