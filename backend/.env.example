# Smart Care System — Backend environment template
# Copy to .env for local development (never commit .env)

PORT=5000
NODE_ENV=development

# CORS + Socket.io allowed origin (frontend URL)
CLIENT_URL=http://localhost:5173

# Optional MongoDB — leave empty for demo (in-memory / stub mode)
MONGODB_URI=

# Optional CareGuard thresholds (minutes)
# CAREGUARD_LAB_DELAY_MINUTES=15
# CAREGUARD_TREATMENT_GRACE_MINUTES=0

# Production example:
# PORT=5000
# NODE_ENV=production
# CLIENT_URL=https://your-frontend-host.example.com
# MONGODB_URI=
