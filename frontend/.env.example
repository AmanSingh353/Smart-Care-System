# Smart Care System — Frontend environment template
# Copy to .env / .env.local for local development. Never commit real values.
#
# Only VITE_* variables are available to the browser bundle.

# Backend API + Socket.io base URL (no trailing slash)
VITE_API_URL=http://localhost:5000

# Demo mode (deterministic fictional patient data)
VITE_DEMO_MODE=true

# ---------------------------------------------------------------------------
# Firebase Authentication (public web client config — NOT Admin secrets)
# From Firebase Console → Project settings → Your apps → Web app
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional CareGuard thresholds (minutes)
# VITE_CAREGUARD_LAB_DELAY_MINUTES=15
# VITE_CAREGUARD_TREATMENT_GRACE_MINUTES=0

# ---------------------------------------------------------------------------
# DO NOT put these in the frontend:
#   MONGODB_URI
#   FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY
#   BOOTSTRAP_ADMIN_PASSWORD
#   any service account JSON
# ---------------------------------------------------------------------------
