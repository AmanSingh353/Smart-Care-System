# Smart Care System — Frontend environment template
# Copy to .env for local development (never commit .env)

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:5000

# Demo mode (deterministic fictional data). Set to "false" only if intentionally disabling.
VITE_DEMO_MODE=true

# Optional CareGuard thresholds (minutes) — DEMO MODE uses short delays by default
# VITE_CAREGUARD_LAB_DELAY_MINUTES=15
# VITE_CAREGUARD_TREATMENT_GRACE_MINUTES=0

# Production example:
# VITE_API_URL=https://your-api-host.example.com
