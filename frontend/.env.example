# Smart Care System — Frontend environment template
# Copy to .env for local development. Never commit real .env values.
#
# Deploy target: Vercel
# Only VITE_* variables are available to the browser bundle.

# Backend API + Socket.io base URL (no trailing slash)
# Local:  http://localhost:5000
# Prod:   https://YOUR-BACKEND-URL  (Render service URL)
VITE_API_URL=http://localhost:5000

# Demo mode (deterministic fictional data). Use "true" for hackathon demos.
VITE_DEMO_MODE=true

# Optional CareGuard thresholds (minutes)
# VITE_CAREGUARD_LAB_DELAY_MINUTES=15
# VITE_CAREGUARD_TREATMENT_GRACE_MINUTES=0

# ---------------------------------------------------------------------------
# DO NOT put these in the frontend (backend-only / secrets):
#   MONGODB_URI
#   FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY
#   any service account JSON or private keys
# ---------------------------------------------------------------------------
